// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-left": 18,
  "margin-right": 18,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad",
    "sway/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/hardware"
  ],
  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "tray",
      "pulseaudio",
      "backlight",
      "network",
      "keyboard-state",
      "battery"
    ]
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}"
  },
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": [
      "",
      ""
    ],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": "{name} {icon}",
    "format-icons": {
      "locked": "",
      "unlocked": ""
    },
    "cursor": false
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M - %d/%m/%Y}",
    "format-alt": "{:%H:%M}"
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "scroll-step": 5,
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "cursor": true
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml",
    "menu-actions": {
      "logout": "swaymsg exit",
      "reboot": "systemctl reboot",
      "shutdown": "systemctl poweroff"
    },
    "cursor": true
  },
  "network": {
    "format": "{ipaddr} ",
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ipaddr} 🖧",
    "format-disconnected": "Disconnected ⚠",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click": "kitty -e nmtui",
    "cursor": true
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "MUTED",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "phone": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol",
    "cursor": true
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10,
    "cursor": true
  }
}
